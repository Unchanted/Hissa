# Dedicated Rabdi TEST wallet only. Never use a wallet holding real assets.
ARKIV_WRITER_PRIVATE_KEY=
# Optional for the probe; recommended to avoid the public RPC rate limit.
ARKIV_ACCESS_KEY=

# --- Hedera testnet (x402 payments + HCS payment log) ---
# Platform treasury: receives x402 payments, pays for setup. ECDSA key (ED25519 does not work with x402).
HEDERA_TREASURY_ID=0.0.xxxxx
HEDERA_TREASURY_KEY=0x...
# Filled in by `npm run hedera:setup`:
AGENT_HEDERA_ACCOUNT_ID=
AGENT_HEDERA_PRIVATE_KEY=
HEDERA_PAYMENT_TOPIC_ID=
# Agent spending controls, in HBAR
AGENT_INITIAL_HBAR=30
AGENT_BUDGET_HBAR=10
AGENT_MAX_PER_PURCHASE_HBAR=5
AGENT_DAILY_CAP_HBAR=25
# Optional
# X402_FACILITATOR_URL=https://api.testnet.blocky402.com
# PORT=4021
# API_URL=http://localhost:4021
